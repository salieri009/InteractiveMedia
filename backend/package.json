{
  "name": "interactive-media-backend",
  "version": "2.0.0",
  "description": "Serverless backend for Interactive Media Assignment",
  "main": "src/api/index.ts",
  "scripts": {
    "start": "node dist/api/index.js",
    "dev": "nodemon --exec ts-node src/api/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "deploy": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod --dir=../",
    "test": "jest"
  },
  "keywords": [
    "serverless",
    "express",
    "vercel",
    "typescript",
    "interactive-media"
  ],
  "author": "UTS Student",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^6.8.1",
    "morgan": "^1.10.0",
    "aws-sdk": "^2.1467.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
