{
  "compilerOptions": {
    /* ================================================================
     * Backend TypeScript Configuration — Interactive Media v2.0.0
     * Target: Node.js 18+, CommonJS output for serverless compatibility.
     * ================================================================ */

    /* Language target */
    "target": "ES2020",
    "lib": ["ES2020"],

    /* CommonJS output so Express and serverless-http work correctly */
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Strict type safety */
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Interop — needed for default imports from CommonJS packages */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    /* Output — Vercel/Netlify functions look for dist/api/index.js */
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "./dist/types"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
